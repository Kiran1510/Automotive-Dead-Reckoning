# Raw input data (large .mcap bags)
data/

# Generated outputs: ignore regenerable CSVs/JSONs but version-track the PNG plots
# so they're browsable on GitHub without running the pipeline.
build/*/*.csv
build/*/*.json

# Local Python virtualenv
.venv/

# Python bytecode
__pycache__/
*.pyc

# Editor / OS noise
.DS_Store
*.swp

# Local-only documentation / config
.claude/
CLAUDE.md
